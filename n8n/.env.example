# Keep n8n patched. 2.38.2 is the minimum pinned baseline for this integration.
N8N_VERSION=2.38.2
N8N_PORT=5678
N8N_ENCRYPTION_KEY=REPLACE_WITH_A_RANDOM_64_HEX_CHARACTER_VALUE

# Required before publishing GitHub Trigger workflows through public ingress.
# n8n 2.38.2 reads N8N_WEBHOOK_URL (the legacy WEBHOOK_URL name is deprecated
# and only used as a fallback if N8N_WEBHOOK_URL is unset).
# Example: https://portfolio-webhooks.example.ts.net/
N8N_WEBHOOK_URL=
N8N_PROXY_HOPS=1
