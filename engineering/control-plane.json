{
  "schema_version": 1,
  "portfolio_project": "Engineering Portfolio Orchestrator",
  "repository": "jweter/project-orchestrator",
  "repository_role": "portfolio-control-plane",
  "source_of_truth": "live GitHub evidence plus per-repository governing documents",
  "authoritative_documents": [
    "DoWork.txt",
    "engineering/portfolio.json",
    "engineering/knowledge-engine-compatibility.json",
    "engineering/learning-memory.json",
    "engineering/tooling-capabilities.json",
    "docs/ARCHITECTURE.md",
    "docs/ROADMAP.md",
    "docs/project-status.yaml",
    "docs/LOCAL_AGENT_TOOLING.md"
  ],
  "invariants": [
    "product_repositories_retain_product_authority",
    "existing_work_precedes_new_work",
    "never_merge_non_green",
    "never_infer_product_reality",
    "never_invent_readiness_percentage",
    "knowledge_engine_is_one_coordinated_family",
    "standalone_projects_remain_isolated",
    "scheduler_never_self_disables",
    "knowledge_engine_shared_contracts_merge_dependency_safe",
    "tool_availability_is_verified_not_assumed",
    "tooling_uses_least_privilege_and_never_commits_secrets"
  ],
  "definition_of_done": {
    "implementation_complete": true,
    "tests_required_for_change_scope": true,
    "preflight_green_exact_head": true,
    "fresh_pr_ci_green": true,
    "mergeability_resolved": true,
    "blocking_reviews_comments_resolved": true,
    "policy_boundaries_clear": true,
    "documentation_current": true
  },
  "preflight": {
    "required_before_pr": true,
    "executable": "engineering/preflight.py",
    "evidence_file": "preflight-evidence.json",
    "checks": [
      "control_plane",
      "portfolio_inventory",
      "learning_memory",
      "tooling_capabilities",
      "compile",
      "tests",
      "cli_validate"
    ]
  },
  "promotion": {
    "states": [
      "IMPLEMENTING",
      "PREFLIGHT_UNVERIFIED",
      "PREFLIGHT_GREEN",
      "PR_OPEN",
      "CI_PENDING",
      "GREEN",
      "MERGED",
      "PRODUCT_REALITY_PENDING",
      "PRODUCT_REALITY_VERIFIED"
    ]
  },
  "work_ownership": {
    "authority": "live GitHub PRs/issues/branches/commits",
    "manual_ownership_database": false
  },
  "readiness_scoring": {
    "mode": "evidence-derived",
    "prohibit_guessed_percent_complete": true,
    "dimensions": [
      "implementation",
      "automated_verification",
      "integration",
      "product_reality",
      "documentation",
      "security_and_policy"
    ]
  },
  "scheduler": {
    "single_merge_authority": true,
    "max_substantial_new_slices_per_independent_project_per_run": 1,
    "never_self_disable": true
  },
  "compatibility_planning": {
    "knowledge_engine_contract": "engineering/knowledge-engine-compatibility.json",
    "executable": "project-orchestrator compat-plan",
    "rule": "identify direct and transitive consumers before shared-contract changes; prepare dependents first for breaking changes and never knowingly leave the Knowledge Engine family broken"
  },
  "learning_memory": {
    "path": "engineering/learning-memory.json",
    "executable": "project-orchestrator memory-validate",
    "persist_rule": "verified, sanitized lessons only; never persist secrets, credentials, raw private Product Reality payloads, or unverified conclusions",
    "deduplication": "content-derived lesson_id"
  },
  "tooling_leverage": {
    "registry": "engineering/tooling-capabilities.json",
    "setup_guide": "docs/LOCAL_AGENT_TOOLING.md",
    "bootstrap": "scripts/setup-agent-tools.ps1",
    "rule": "adopt free maintainable tools only when they close an observed feedback-loop gap; prefer official implementations, least privilege, local/advisory introduction before material CI cost, and never report availability before verification",
    "preferred_mcp": [
      "github/github-mcp-server",
      "microsoft/playwright-mcp"
    ],
    "paid_or_meaningful_recurring_cost_requires_jeremy": true
  }
}
