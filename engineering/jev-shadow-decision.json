{
  "schema_version": 1,
  "mode": "SHADOW_ONLY",
  "provider": "TypeSafe Jev System One",
  "model_default": "jev-latest",
  "endpoint_default": "https://api.typesafe.ai/v1/systemone",
  "purpose": "rank or select only among candidates already admitted by deterministic repository and portfolio policy",
  "authority": "ADVISORY_ONLY",
  "deterministic_preconditions": [
    "P0-P4 priority and repair obligations already resolved for the decision point",
    "repository-local authority and roadmap permit every candidate",
    "ownership and conflict checks clear every candidate",
    "Product Reality dependency gates clear every candidate",
    "security privacy licensing provenance and architecture boundaries clear every candidate",
    "candidate action space is explicit and bounded"
  ],
  "short_circuit_rule": "zero legal candidates means no neural call; one legal candidate means deterministic selection with no neural call",
  "live_call_guard": {
    "required_environment": [
      "JEV_SHADOW_LIVE=1",
      "TYPESAFE_API_KEY"
    ],
    "credentials_may_be_committed": false,
    "automatic_paid_calls": false
  },
  "forbidden_authority": [
    "create legality",
    "override deterministic priority",
    "override branch ownership",
    "bypass preflight or CI",
    "merge",
    "infer Product Reality",
    "change security or privacy boundaries",
    "change licensing or provenance policy",
    "authorize destructive or irreversible actions",
    "authorize release or publishing"
  ],
  "telemetry": [
    "decision state",
    "deterministic legal candidate ids",
    "selected candidate id when valid",
    "returned legal-set probabilities when available",
    "whether a neural call was made"
  ],
  "promotion_policy": "remain shadow-only until comparable replay/live evidence demonstrates better liveness or routing without quality, policy, cost, or human-boundary regression",
  "evidence_ledger": {
    "implementation": "project_orchestrator.jev_evidence",
    "storage_class": "append-only telemetry JSONL",
    "outcome_binding": "only candidates from the recorded deterministic legal set",
    "replay_metrics": [
      "disagreement rate",
      "shadow matched verified advancement",
      "deterministic matched verified advancement",
      "ties or inconclusive",
      "per-project sample count"
    ],
    "self_promotion": false
  },
  "automatic_reconciliation": {
    "implementation": "project_orchestrator.jev_reconciliation",
    "decision_source": "Foreman multi-candidate shadow observations",
    "identity_key": "specialist lane_id / candidate_id",
    "terminal_success_states": [
      "MERGED",
      "PRODUCT_REALITY_VERIFIED",
      "VERIFIED_ADVANCEMENT"
    ],
    "pending_results_close_record": false,
    "inferred_success_forbidden": true
  },
  "runtime_evidence": {
    "implementation": "project_orchestrator.jev_runtime",
    "cli": "project-orchestrator jev-runtime-cycle",
    "default_path": "telemetry/jev-shadow/decisions.jsonl",
    "idempotency": "run_id + project_id",
    "persistence": "atomic JSONL rewrite after capture/reconciliation",
    "pending_result_rewrite": false,
    "execution_authority": false,
    "promotion_authority": false
  },
  "unattended_integration": {
    "implementation": "project_orchestrator.unattended_cycle",
    "cli": "project-orchestrator unattended-cycle",
    "sequence": [
      "build deterministic Foreman plan",
      "persist Jev shadow evidence",
      "reconcile terminal execution evidence",
      "expose unchanged Foreman dispatch queue"
    ],
    "dispatch_source": "Foreman/Steward only",
    "jev_dispatch_authority": false,
    "duplicate_scheduler_created": false
  },
  "experiment_baseline": {
    "implementation": "project_orchestrator.jev_experiment",
    "cli": "project-orchestrator jev-experiment-report",
    "states": [
      "NO_LIVE_JEV_OBSERVATIONS",
      "LIVE_OBSERVATION_PENDING",
      "MEASURED_LIVE_BASELINE"
    ],
    "neural_evidence_requirement": "neural_call_made=true",
    "completed_baseline_requirement": "neural_call_made=true plus explicit terminal outcome",
    "pending_request_is_performance_evidence": false,
    "promotion_authority": false
  }
}
