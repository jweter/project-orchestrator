+# A scan of Git slices/worktrees alone cannot establish post-reboot
+# reconstruction of the other durable state authorities.
+REQUIRED_RECOVERY_SOURCES = frozenset({
+    "accepted_baseline", "publication_queue", "candidates",
+    "active_work", "leases",
+})
+
+
 @dataclass(frozen=True)
 class RecoveryReconstructionReport:
     slice_states: tuple[ReconstructedSliceState, ...]
     worktree_bootstrap: tuple[BootstrapEntry, ...]
     worktree_classifications: tuple[WorktreeClassification, ...]
+    verified_recovery_sources: frozenset[str] = frozenset()
 
     @property
     def has_ambiguous_slice(self) -> bool:
@@ -58,11 +67,24 @@ class RecoveryReconstructionReport:
         )
 
     @property
-    def clean(self) -> bool:
-        """True only when nothing ambiguous or orphaned was found --
-        the proof that reconstruction would be unambiguous right now."""
+    def inventory_clean(self) -> bool:
+        """Only the examined slice/worktree inventory was unambiguous."""
         return not self.has_ambiguous_slice and not self.has_orphaned_worktree
 
+    @property
+    def missing_recovery_sources(self) -> frozenset[str]:
+        """Durable authorities not independently reconstructed by this report."""
+        return REQUIRED_RECOVERY_SOURCES - self.verified_recovery_sources
+
+    @property
+    def clean(self) -> bool:
+        """Full recovery is unproven until every required authority is covered."""
+        return (
+            bool(self.slice_states)
+            and self.inventory_clean
+            and not self.missing_recovery_sources
+        )
+
 
