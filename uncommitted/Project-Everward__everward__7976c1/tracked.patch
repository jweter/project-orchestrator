-FString PercentString(double Value, double Capacity)
-{
-    if (Capacity <= 0.0)
-    {
-        return TEXT("--");
-    }
-    return FString::Printf(TEXT("%.0f%%"), FMath::Clamp(Value / Capacity, 0.0, 1.0) * 100.0);
-}
