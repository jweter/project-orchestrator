-    const auto next_unit_double = [&state]() -> double {
-        // Top 53 bits of a 64-bit draw give a double uniformly in [0, 1).
-        return static_cast<double>(detail::splitmix64_next(state) >> 11) * (1.0 / 9007199254740992.0);
-    };
