-        title = candidate.title.lower()
-        if "security" in title:
-            lane = "security"
-        elif "test" in title or "regression" in title:
-            lane = "tests"
-        elif "doc" in title:
-            lane = "docs"
-        elif candidate.product_reality_dependent:
