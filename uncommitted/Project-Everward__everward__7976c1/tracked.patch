-    telemetry.body_id = found->body_id;
-    telemetry.surface_range_m = surface_range_to_body(probe_position_m, *found);
-    telemetry.closing_speed_mps = closing_speed_to_body(probe_position_m, probe_velocity_mps, *found);
-    return telemetry;
-}
