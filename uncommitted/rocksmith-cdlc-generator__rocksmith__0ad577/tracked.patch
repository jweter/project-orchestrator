-    )
-    technique_recall = (
-        technique_tp / (technique_tp + technique_fn)
-        if technique_tp + technique_fn
-        else None
-    )
-    technique_f1 = (
-        _f1(technique_precision, technique_recall)
-        if technique_precision is not None and technique_recall is not None
