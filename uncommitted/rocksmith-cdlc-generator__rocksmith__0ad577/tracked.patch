-            0.0,
-            1.0 - abs(band_height - typical_height) / max(typical_height, 1.0),
-        )
-        peak = min(1.0, max(strengths[start:end], default=0.0))
-        confidence = max(0.0, min(1.0, 0.75 * height_fit + 0.25 * min(1.0, peak / 0.12)))
-        systems.append(
-            DetectedScoreSystem(
