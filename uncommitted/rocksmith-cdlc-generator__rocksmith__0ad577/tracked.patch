-                    confidence=0.0,
-                    review_required=True,
-                    reason="No compatible Rocksmith catalog device matched this component family.",
-                ))
-                warnings.append(f"No Rocksmith device matched {suggestion.family}.")
-                continue
-            best_score, device = candidates[0]
