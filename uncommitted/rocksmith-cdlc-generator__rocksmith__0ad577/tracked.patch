-def _nearby_indexed_audio(
-    starts: list[float],
-    ordered: list[tuple[int, NoteEvent]],
-    center: float,
-    radius: float,
-) -> list[tuple[int, NoteEvent]]:
-    left = bisect_left(starts, center - radius)
-    right = bisect_right(starts, center + radius)
