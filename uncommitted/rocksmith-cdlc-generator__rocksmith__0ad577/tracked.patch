-        if argv[1] not in _AUTOMATIC_COMMANDS:
-            raise ValueError(f"Planner command is not an approved automatic CDLC operation: {command}")
-        return argv
-    if argv[0] in _AUTOMATIC_ENTRYPOINTS:
-        return argv
-    raise ValueError(f"Planner command is not an approved automatic CDLC operation: {command}")
-
-
