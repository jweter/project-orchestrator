-def _longest_vertical_run(image: Image.Image, x: int, *, threshold: int = 64) -> int:
-    pixels = image.load()
-    longest = 0
-    current = 0
-    for y in range(image.height):
-        if pixels[x, y] >= threshold:
-            current += 1
-            longest = max(longest, current)
-        else:
-            current = 0
-    return longest
