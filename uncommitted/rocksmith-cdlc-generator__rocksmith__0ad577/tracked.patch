-def _confidence_from_margin(best_cost: float, second_cost: float | None) -> float:
-    if second_cost is None:
-        return 0.92
-    margin = max(0.0, second_cost - best_cost)
-    return min(0.99, 0.55 + margin / (margin + 5.0) * 0.44)
