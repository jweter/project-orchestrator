-    assert len(layer.decisions) == 1
-    assert layer.decisions[0].midi == 47
-    assert layer.decisions[0].source_track_index == 2  # confirmed primary track index
-
-    # Event index 1 is track 2's note (string 0, fret 3 -> midi 40 + 3 = 43).
