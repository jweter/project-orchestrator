-
-def _tempo_value(change: Any) -> float | None:
-    if change is None:
-        return None
-    value = getattr(change, "value", change)
-    try:
-        bpm = float(value)
-    except (TypeError, ValueError):
-        return None
-    return bpm if bpm > 0 else None
