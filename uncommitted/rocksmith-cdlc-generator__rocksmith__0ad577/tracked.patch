-
-def _f1(precision: float, recall: float) -> float:
-    return 2.0 * precision * recall / (precision + recall) if precision + recall else 0.0
-
-
-def _mean(values: Iterable[float]) -> float | None:
-    rows = list(values)
-    return sum(rows) / len(rows) if rows else None
