-        except FileExistsError:
-            if _existing_lock_is_active(path):
-                return None
-            try:
-                path.unlink()
-            except FileNotFoundError:
-                continue
-            except OSError:
-                return None
-            continue
-        os.write(fd, str(os.getpid()).encode("ascii"))
-        return fd
-    return None
