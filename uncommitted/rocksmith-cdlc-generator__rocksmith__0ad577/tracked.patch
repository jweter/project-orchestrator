-    if raw_count == 0:
-        return "0 warnings"
-    groups_word = "group" if actionable_count == 1 else "groups"
-    events_word = "event" if raw_count == 1 else "events"
-    return (
-        f"{actionable_count} actionable warning {groups_word} · "
