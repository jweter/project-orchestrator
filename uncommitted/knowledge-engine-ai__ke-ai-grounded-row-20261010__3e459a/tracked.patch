+@pytest.mark.parametrize("field_name", ["conclusion", "certainty_rationale"])
+def test_parse_rejects_uncited_grounded_conclusion_text(field_name: str) -> None:
+    payload = _payload()
+    rows = payload["conclusion_rows"]
+    assert isinstance(rows, list)
+    row = rows[0]
+    assert isinstance(row, dict)
+    row[field_name] = "The trial establishes an acute blood-pressure increase."
+
+    with pytest.raises(ResearchReportError, match="requires an evidence citation"):
+        parse_research_report_proposal(
+            payload,
+            known_evidence_ids=frozenset({"ev-positive", "ev-null"}),
+        )
+
+
+def test_parse_allows_unavailable_row_without_evidence_or_citation() -> None:
+    payload = _payload()
+    rows = payload["conclusion_rows"]
+    assert isinstance(rows, list)
+    row = rows[0]
+    assert isinstance(row, dict)
+    row["certainty"] = "unavailable"
+    row["supporting_evidence_ids"] = []
+    row["conclusion"] = "No grounded conclusion is available."
+    row["certainty_rationale"] = "The evidence record is insufficient."
+
+    proposal = parse_research_report_proposal(
+        payload,
+        known_evidence_ids=frozenset({"ev-positive", "ev-null"}),
+    )
+    assert proposal.conclusion_rows[0].certainty is ReportCertainty.UNAVAILABLE
+
